// social-culture.club — modèle de données unifié (lot 0)
// Catalogue interne partagé (D29), sans référentiel externe (D6).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

// ─────────────────────────────────────────────────────────────
// Authentification (tables gérées par better-auth)
// ─────────────────────────────────────────────────────────────

model User {
  id            String   @id
  name          String // nom d'affichage
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String? // URL de l'avatar
  bio           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // plugin username
  username        String? @unique
  displayUsername String?

  // plugin admin
  role       String?   @default("user") // "user" | "admin"
  banned     Boolean   @default(false)
  banReason  String?
  banExpires DateTime?

  sessions Session[]
  accounts Account[]

  // relations applicatives
  worksCreated    Work[]       @relation("WorkCreatedBy")
  imagesUploaded  Image[]      @relation("ImageUploadedBy")
  invitationsSent Invitation[] @relation("InvitationInvitedBy")
  invitationUsed  Invitation[] @relation("InvitationUsedBy")

  // suivi personnel (lot 1)
  userWorks       UserWork[]
  userSeasons     UserSeason[]
  journalEntries  JournalEntry[]
  episodeWatches  EpisodeWatch[]
  tomeProgress    TomeProgress[]
  readingProgress ReadingProgress[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String? // plugin admin

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ─────────────────────────────────────────────────────────────
// Invitations (inscription en cercle privé — D24)
// ─────────────────────────────────────────────────────────────

model Invitation {
  id          String    @id @default(cuid())
  code        String    @unique
  email       String? // optionnel : invitation nominative
  invitedById String
  invitedBy   User      @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  usedById    String?
  usedBy      User?     @relation("InvitationUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([invitedById])
}

// ─────────────────────────────────────────────────────────────
// Catalogue d'œuvres (D6, D29, D30, D31)
// ─────────────────────────────────────────────────────────────

enum WorkType {
  FILM
  SERIES
  ANIME
  BOOK
  BD_SERIES
  MANGA_SERIES
  ONE_SHOT
}

model Work {
  id              String   @id @default(cuid())
  type            WorkType
  titleFr         String
  titleOriginal   String?
  titleNormalized String // minuscule + sans accents, pour dédup et recherche pg_trgm
  year            Int
  synopsis        String?
  durationMinutes Int? // films / épisodes
  pageCount       Int? // livres / one-shots
  isbn            String? // champ libre saisi (D6 : jamais utilisé pour un lookup externe)
  metadata        Json     @default("{}") // ex. { "format": "TV" } pour les animés

  coverImageId String?
  coverImage   Image?  @relation("WorkCover", fields: [coverImageId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User     @relation("WorkCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  genres   WorkGenre[]
  creators WorkCreator[]
  seasons  Season[]
  tomes    Tome[]
  editions Edition[]

  // suivi personnel (lot 1)
  userWorks       UserWork[]
  journalEntries  JournalEntry[]
  readingProgress ReadingProgress[]

  @@index([type])
  @@index([createdById])
  @@index([year])
  // Recherche floue et détection de doublons (S1/S2) — index GIN pg_trgm,
  // désormais géré par Prisma pour ne plus être supprimé à chaque migration.
  @@index([titleNormalized(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Genre {
  id    String      @id @default(cuid())
  name  String      @unique
  slug  String      @unique
  works WorkGenre[]
}

model WorkGenre {
  workId  String
  work    Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  genreId String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([workId, genreId])
  @@index([genreId])
}

model Person {
  id             String        @id @default(cuid())
  name           String
  nameNormalized String        @unique
  works          WorkCreator[]
}

model WorkCreator {
  id       String  @id @default(cuid())
  workId   String
  work     Work    @relation(fields: [workId], references: [id], onDelete: Cascade)
  personId String
  person   Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  role     String? // réalisateur, auteur, scénariste, dessinateur…

  @@unique([workId, personId, role])
  @@index([personId])
}

// ─────────────────────────────────────────────────────────────
// Sous-unités : saisons/épisodes (séries, animés), tomes (BD, mangas — D7)
// ─────────────────────────────────────────────────────────────

model Season {
  id       String    @id @default(cuid())
  workId   String
  work     Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  number   Int
  title    String?
  episodes Episode[]

  userSeasons    UserSeason[]
  journalEntries JournalEntry[]

  @@unique([workId, number])
}

model Episode {
  id              String    @id @default(cuid())
  seasonId        String
  season          Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  number          Int
  title           String?
  durationMinutes Int?
  airDate         DateTime? // indicatif uniquement (D15)

  watches        EpisodeWatch[]
  journalEntries JournalEntry[]

  @@unique([seasonId, number])
}

model Tome {
  id           String    @id @default(cuid())
  workId       String
  work         Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  number       Int
  title        String?
  pageCount    Int?
  coverImageId String?
  coverImage   Image?    @relation("TomeCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  editions     Edition[]

  progress       TomeProgress[]
  journalEntries JournalEntry[]

  @@unique([workId, number])
}

// ─────────────────────────────────────────────────────────────
// Éditions (D8) — modèle complet prêt dès le lot 0, UI au lot 3
// ─────────────────────────────────────────────────────────────

model Edition {
  id        String  @id @default(cuid())
  workId    String?
  work      Work?   @relation(fields: [workId], references: [id], onDelete: Cascade)
  tomeId    String?
  tome      Tome?   @relation(fields: [tomeId], references: [id], onDelete: Cascade)
  isbn      String?
  pageCount Int?
  publisher String?
  format    String? // poche, broché, numérique, intégrale…
  isDefault Boolean @default(false)

  // Intégrale : étendue de tomes couverts (leur lecture les marque comme lus — lot 1/3)
  coversTomeFrom Int?
  coversTomeTo   Int?

  coverImageId String?
  coverImage   Image?  @relation("EditionCover", fields: [coverImageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  journalEntries  JournalEntry[]
  readingProgress ReadingProgress[]

  @@index([workId])
  @@index([tomeId])
}

// ─────────────────────────────────────────────────────────────
// Visuels téléversés (stockés sur disque, servis via /api/uploads/[id])
// ─────────────────────────────────────────────────────────────

model Image {
  id           String   @id @default(cuid())
  path         String // chemin relatif dans UPLOADS_DIR
  width        Int?
  height       Int?
  uploadedById String?
  uploadedBy   User?    @relation("ImageUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  coverForWorks    Work[]    @relation("WorkCover")
  coverForTomes    Tome[]    @relation("TomeCover")
  coverForEditions Edition[] @relation("EditionCover")
}

// ─────────────────────────────────────────────────────────────
// Suivi personnel (lot 1) — données individuelles par utilisateur
// Le catalogue reste partagé (D29) ; tout ce qui suit est privé.
// ─────────────────────────────────────────────────────────────

enum WorkStatusState {
  WANT // à voir / à lire / envie de lire
  IN_PROGRESS // en cours
  ON_HOLD // en pause
  DROPPED // abandonné
  COMPLETED // terminé
  CAUGHT_UP // à jour (séries/animés uniquement)
}

// Précision d'une date de journal (S4) : jour, mois, année, inconnue.
enum DatePrecision {
  DAY
  MONTH
  YEAR
  UNKNOWN
}

// Suivi au tome (L4) — l'absence de ligne signifie « à lire ».
enum TomeState {
  READING
  READ
}

/// Ma relation à une œuvre : statut, note actuelle, j'aime, progression (§8).
model UserWork {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  state WorkStatusState? // nullable : on peut aimer/noter sans statut

  currentRating Int? // note actuelle sur 10 (S5) — modifiable hors journal
  liked         Boolean @default(false) // j'aime indépendant (S6)

  // critique rattachée directement à l'œuvre (S7)
  reviewText       String?
  reviewHasSpoiler Boolean   @default(false)
  reviewedAt       DateTime?

  // progression de lecture (L2) — cache de la dernière valeur
  currentPage     Int?
  progressPercent Int?

  startedAt  DateTime? // L1
  finishedAt DateTime? // L1

  rewatchCount  Int       @default(0) // re-consommations (F2), dérivé du journal
  watchlistedAt DateTime? // date d'ajout watchlist quand state = WANT (F1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workId])
  @@index([userId])
  @@index([workId])
  @@index([userId, state])
}

/// Note et critique de saison (T3, D5) — indépendantes de la note de série.
model UserSeason {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  rating           Int? // sur 10
  reviewText       String?
  reviewHasSpoiler Boolean @default(false)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, seasonId])
  @@index([userId])
}

/// Le journal daté (S4) — colonne vertébrale du suivi.
model JournalEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  // sous-unité éventuellement concernée + édition lue (D8)
  seasonId  String?
  season    Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  tomeId    String?
  tome      Tome?    @relation(fields: [tomeId], references: [id], onDelete: SetNull)
  editionId String?
  edition   Edition? @relation(fields: [editionId], references: [id], onDelete: SetNull)

  loggedAt      DateTime? // null = date inconnue
  datePrecision DatePrecision @default(DAY)

  rating           Int? // note du visionnage/lecture, sur 10
  reviewText       String? // critique rattachée à l'entrée (S7)
  reviewHasSpoiler Boolean @default(false)

  isRewatch     Boolean @default(false) // revisionnage/relecture (F2)
  context       String? // contexte de consommation (F3, D10)
  isSeasonBatch Boolean @default(false) // entrée synthétique d'un marquage de saison (T4)

  watches EpisodeWatch[] // épisodes liés à une entrée synthétique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, loggedAt])
  @@index([workId])
}

/// Progression à l'épisode (T1) — la présence = épisode vu.
model EpisodeWatch {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  watchedAt DateTime? // défaut aujourd'hui ; modifiable ; ou « sans date »

  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([userId, episodeId])
  @@index([userId])
}

/// Suivi au tome (L4).
model TomeProgress {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tomeId String
  tome   Tome      @relation(fields: [tomeId], references: [id], onDelete: Cascade)
  state  TomeState

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, tomeId])
  @@index([userId])
}

/// Historique de progression de lecture (L2) — alimente le rythme de lecture.
model ReadingProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  editionId String?
  edition   Edition? @relation(fields: [editionId], references: [id], onDelete: SetNull)

  page    Int?
  percent Int?

  recordedAt DateTime @default(now())

  @@index([userId, workId, recordedAt])
}
