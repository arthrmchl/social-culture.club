// social-culture.club — modèle de données unifié (lot 0)
// Catalogue interne partagé (D29), sans référentiel externe (D6).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

// ─────────────────────────────────────────────────────────────
// Authentification (tables gérées par better-auth)
// ─────────────────────────────────────────────────────────────

model User {
  id            String   @id
  name          String // nom d'affichage
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String? // URL de l'avatar
  bio           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // plugin username
  username        String? @unique
  displayUsername String?

  // plugin admin
  role       String?   @default("user") // "user" | "admin"
  banned     Boolean   @default(false)
  banReason  String?
  banExpires DateTime?

  /// Visibilité du compte (lot 4, D26, P5).
  ///
  /// Ces trois champs ne sont **pas** déclarés dans `user.additionalFields` de
  /// `src/lib/auth.ts` : on les lit toujours en base. Les inscrire dans la
  /// session figerait la visibilité jusqu'à son expiration — passer son compte
  /// en privé doit prendre effet immédiatement.
  visibility ProfileVisibility @default(PUBLIC)

  /// Restrictions par section. Des booléens et non un second énuméré : ils ne
  /// peuvent que **restreindre** la visibilité du compte, jamais l'élargir. La
  /// visibilité effective d'une section est donc `min(compte, section)`, une
  /// seule règle à écrire — et pas de combinatoire absurde du type « journal
  /// public sur compte privé ».
  showJournalPublicly Boolean @default(true)
  showStatsPublicly   Boolean @default(true)

  sessions Session[]
  accounts Account[]

  // relations applicatives
  worksCreated    Work[]       @relation("WorkCreatedBy")
  imagesUploaded  Image[]      @relation("ImageUploadedBy")
  invitationsSent Invitation[] @relation("InvitationInvitedBy")
  invitationUsed  Invitation[] @relation("InvitationUsedBy")

  // suivi personnel (lot 1)
  userWorks       UserWork[]
  userSeasons     UserSeason[]
  journalEntries  JournalEntry[]
  episodeWatches  EpisodeWatch[]
  tomeProgress    TomeProgress[]
  readingProgress ReadingProgress[]

  // bibliothèque riche (lot 3)
  lists     List[]
  tags      Tag[]
  favorites Favorite[]
  goals     Goal[]

  // social (lot 4)
  following          Follow[]               @relation("FollowFollower")
  followers          Follow[]               @relation("FollowFollowing")
  blocksMade         Block[]                @relation("BlockBlocker")
  blocksReceived     Block[]                @relation("BlockBlocked")
  socialLikes        SocialLike[]
  comments           Comment[]
  notifications      Notification[]         @relation("NotificationRecipient")
  notificationsSent  Notification[]         @relation("NotificationActor")
  reportsFiled       Report[]               @relation("ReportReporter")
  reportsAgainst     Report[]               @relation("ReportReportedUser")
  reportsResolved    Report[]               @relation("ReportResolver")
  corrections        CorrectionSuggestion[] @relation("CorrectionAuthor")
  correctionsHandled CorrectionSuggestion[] @relation("CorrectionHandler")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String? // plugin admin

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ─────────────────────────────────────────────────────────────
// Invitations (inscription en cercle privé — D24)
// ─────────────────────────────────────────────────────────────

model Invitation {
  id          String    @id @default(cuid())
  code        String    @unique
  email       String? // optionnel : invitation nominative
  invitedById String
  invitedBy   User      @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  usedById    String?
  usedBy      User?     @relation("InvitationUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([invitedById])
}

// ─────────────────────────────────────────────────────────────
// Catalogue d'œuvres (D6, D29, D30, D31)
// ─────────────────────────────────────────────────────────────

enum WorkType {
  FILM
  SERIES
  ANIME
  BOOK
  BD_SERIES
  MANGA_SERIES
}

/// L'œuvre est le texte, pas l'objet publié : ni ISBN, ni pagination, ni
/// couverture pour un média de lecture — tout cela appartient à l'`Edition`.
model Work {
  id               String   @id @default(cuid())
  type             WorkType
  titleFr          String
  titleOriginal    String?
  titleNormalized  String // minuscule + sans accents, pour dédup et recherche pg_trgm
  /// Langue originale, code ISO 639-1 (voir src/lib/languages.ts). Une
  /// traduction est déclarée par l'édition, pas par l'œuvre.
  originalLanguage String?
  year             Int? // année de première publication ; inconnue possible à l'import (lot 2)
  /// Année de fin, pour les seules œuvres sérielles (`isSerial`, src/lib/media.ts) :
  /// une série se publie sur une période, pas une année. **Nulle = en cours**
  /// — c'est la lecture qu'en fait `formatYears`, et il n'y a pas de troisième
  /// état : un manga arrêté sans qu'on sache quand se corrige, il ne se
  /// déclare pas « fin inconnue ».
  endYear          Int?
  synopsis         String?
  durationMinutes  Int? // films / épisodes
  metadata         Json     @default("{}") // ex. { "format": "TV" } pour les animés

  // Fiche importée (lot 2, I1) : ni visuel ni métadonnées complètes, à enrichir
  // depuis la file de complétion. L'obligation de visuel (D31) ne vaut que pour
  // la création manuelle.
  needsCompletion Boolean @default(false)

  /// Réservé aux médias **non-lecture** (`worksOwnCover`, src/lib/media.ts) :
  /// la couverture d'un livre, d'une BD ou d'un manga est celle de son édition.
  coverImageId String?
  coverImage   Image?  @relation("WorkCover", fields: [coverImageId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User     @relation("WorkCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  genres   WorkGenre[]
  creators WorkCreator[]
  seasons  Season[]
  // Pas de `tomes` : un tome appartient à une édition (lot 6), jamais à
  // l'œuvre — Berserk fait 41 tomes chez Glénat et 14 en Deluxe.
  editions Edition[]

  // suivi personnel (lot 1)
  userWorks       UserWork[]
  journalEntries  JournalEntry[]
  readingProgress ReadingProgress[]

  // bibliothèque riche (lot 3)
  listItems ListItem[]
  tags      WorkTag[]
  favorites Favorite[]

  // social (lot 4)
  corrections   CorrectionSuggestion[]
  notifications Notification[]
  reports       Report[]

  @@index([type])
  @@index([createdById])
  @@index([year])
  @@index([needsCompletion])
  // Recherche floue et détection de doublons (S1/S2) — index GIN pg_trgm,
  // désormais géré par Prisma pour ne plus être supprimé à chaque migration.
  @@index([titleNormalized(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Genre {
  id    String      @id @default(cuid())
  name  String      @unique
  slug  String      @unique
  works WorkGenre[]
}

model WorkGenre {
  workId  String
  work    Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  genreId String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([workId, genreId])
  @@index([genreId])
}

model Person {
  id             String           @id @default(cuid())
  name           String
  nameNormalized String           @unique
  works          WorkCreator[]
  editions       EditionCreator[]
}

model WorkCreator {
  id       String  @id @default(cuid())
  workId   String
  work     Work    @relation(fields: [workId], references: [id], onDelete: Cascade)
  personId String
  person   Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  role     String? // réalisateur, auteur, scénariste, dessinateur…

  @@unique([workId, personId, role])
  @@index([personId])
}

// ─────────────────────────────────────────────────────────────
// Sous-unités : saisons/épisodes (séries, animés), tomes (BD, mangas — D7)
// ─────────────────────────────────────────────────────────────

model Season {
  id       String    @id @default(cuid())
  workId   String
  work     Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  number   Int
  title    String?
  episodes Episode[]

  userSeasons    UserSeason[]
  journalEntries JournalEntry[]

  @@unique([workId, number])
}

model Episode {
  id              String    @id @default(cuid())
  seasonId        String
  season          Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  number          Int
  title           String?
  durationMinutes Int?
  airDate         DateTime? // indicatif uniquement (D15)

  watches        EpisodeWatch[]
  journalEntries JournalEntry[]

  @@unique([seasonId, number])
}

/// Un tome appartient à son **édition** (lot 6), pas à l'œuvre : le nombre de
/// volumes décrit un tirage. Ce que le lot 5 a fait de l'ISBN et de la
/// pagination, le lot 6 le fait du tome.
model Tome {
  id           String @id @default(cuid())
  editionId    String
  edition      Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  number       Int
  title        String?
  pageCount    Int?
  coverImageId String?
  coverImage   Image?  @relation("TomeCover", fields: [coverImageId], references: [id], onDelete: SetNull)

  progress       TomeProgress[]
  journalEntries JournalEntry[]

  @@unique([editionId, number])
}

// ─────────────────────────────────────────────────────────────
// Éditions (D8) — modèle complet prêt dès le lot 0, UI au lot 3
// ─────────────────────────────────────────────────────────────

model Edition {
  /// Une édition appartient toujours à une œuvre, et à une seule (lot 6) :
  /// elle ne s'attache plus à un tome, puisqu'elle les **contient**.
  id        String  @id @default(cuid())
  workId    String
  work      Work    @relation(fields: [workId], references: [id], onDelete: Cascade)
  /// Titre de cette édition — souvent le titre traduit, parfois un titre de
  /// collection. Vide quand il ne diffère pas de celui de l'œuvre.
  title     String?
  /// Langue de cette édition, code ISO 639-1. Différente de
  /// `Work.originalLanguage` : c'est une traduction, et ses traducteurs sont
  /// dans `creators`.
  language  String?
  isbn      String?
  pageCount Int?
  publisher String?
  format    String? // poche, broché, numérique, intégrale…
  isDefault Boolean @default(false)

  coverImageId String?
  coverImage   Image?  @relation("EditionCover", fields: [coverImageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// Les volumes de ce tirage (BD, mangas). Une intégrale n'est plus qu'une
  /// édition à peu de tomes : elle ne « couvre » plus une étendue, elle a les
  /// siens.
  tomes           Tome[]
  creators        EditionCreator[]
  journalEntries  JournalEntry[]
  readingProgress ReadingProgress[]
  userWorks       UserWork[]

  @@index([workId])
}

/// Qui a fait cette édition-ci et non l'œuvre : traducteur aujourd'hui,
/// préfacier ou illustrateur demain. Calqué sur `WorkCreator`, mais son `role`
/// est obligatoire — une personne rattachée à une édition l'est toujours à un
/// titre précis.
model EditionCreator {
  id        String  @id @default(cuid())
  editionId String
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  personId  String
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  role      String

  @@unique([editionId, personId, role])
  @@index([personId])
}

// ─────────────────────────────────────────────────────────────
// Visuels téléversés (stockés sur disque, servis via /api/uploads/[id])
// ─────────────────────────────────────────────────────────────

model Image {
  id           String   @id @default(cuid())
  path         String // chemin relatif dans UPLOADS_DIR
  width        Int?
  height       Int?
  uploadedById String?
  uploadedBy   User?    @relation("ImageUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  coverForWorks    Work[]    @relation("WorkCover")
  coverForTomes    Tome[]    @relation("TomeCover")
  coverForEditions Edition[] @relation("EditionCover")
  coverForLists    List[]    @relation("ListCover")
}

// ─────────────────────────────────────────────────────────────
// Suivi personnel (lot 1) — données individuelles par utilisateur
// Le catalogue reste partagé (D29) ; tout ce qui suit est privé.
// ─────────────────────────────────────────────────────────────

enum WorkStatusState {
  WANT // à voir / à lire / envie de lire
  IN_PROGRESS // en cours
  ON_HOLD // en pause
  DROPPED // abandonné
  COMPLETED // terminé
  CAUGHT_UP // à jour (séries/animés uniquement)
}

// Précision d'une date de journal (S4) : jour, mois, année, inconnue.
enum DatePrecision {
  DAY
  MONTH
  YEAR
  UNKNOWN
}

// Suivi au tome (L4) — l'absence de ligne signifie « à lire ».
enum TomeState {
  READING
  READ
}

/// Ma relation à une œuvre : statut, note actuelle, j'aime, progression (§8).
model UserWork {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  state WorkStatusState? // nullable : on peut aimer/noter sans statut

  currentRating Int? // note actuelle sur 10 (S5) — modifiable hors journal
  liked         Boolean @default(false) // j'aime indépendant (S6)

  // critique rattachée directement à l'œuvre (S7)
  reviewText       String?
  reviewHasSpoiler Boolean   @default(false)
  reviewedAt       DateTime?

  // progression de lecture (L2) — cache de la dernière valeur
  currentPage     Int?
  progressPercent Int?

  /// Édition que je lis (D8, lot 3) — pilote la pagination affichée. Donnée de
  /// suivi : le catalogue partage les éditions, chacun choisit la sienne.
  editionId String?
  edition   Edition? @relation(fields: [editionId], references: [id], onDelete: SetNull)

  startedAt  DateTime? // L1
  finishedAt DateTime? // L1

  rewatchCount  Int       @default(0) // re-consommations (F2), dérivé du journal
  watchlistedAt DateTime? // date d'ajout watchlist quand state = WANT (F1)

  /// Critique masquée par la modération (lot 4, D25). Elle masque **la critique
  /// seule** : le statut, la note et la progression restent au membre — la
  /// modération ne touche jamais au suivi personnel.
  hiddenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // social (lot 4) — la critique d'œuvre est une cible sociale à part entière
  likes          SocialLike[]
  socialComments Comment[]
  notifications  Notification[]
  reports        Report[]

  @@unique([userId, workId])
  @@index([userId])
  @@index([workId])
  @@index([userId, state])
  /// Les critiques d'un membre, de la plus récente à la plus ancienne (P1, P2).
  /// Prisma ne déclare pas d'index partiel, et un `WHERE reviewedAt IS NOT NULL`
  /// écrit à la main serait supprimé au prochain `migrate dev` — comme l'index
  /// GIN avant sa reprise par Prisma. Les NULL se regroupant en fin d'index,
  /// la requête reste sélective.
  @@index([userId, reviewedAt])
}

/// Note et critique de saison (T3, D5) — indépendantes de la note de série.
model UserSeason {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  rating           Int? // sur 10
  reviewText       String?
  reviewHasSpoiler Boolean @default(false)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, seasonId])
  @@index([userId])
}

/// Le journal daté (S4) — colonne vertébrale du suivi.
model JournalEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  // sous-unité éventuellement concernée + édition lue (D8)
  seasonId  String?
  season    Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  tomeId    String?
  tome      Tome?    @relation(fields: [tomeId], references: [id], onDelete: SetNull)
  editionId String?
  edition   Edition? @relation(fields: [editionId], references: [id], onDelete: SetNull)

  loggedAt      DateTime? // null = date inconnue
  datePrecision DatePrecision @default(DAY)

  rating           Int? // note du visionnage/lecture, sur 10
  reviewText       String? // critique rattachée à l'entrée (S7)
  reviewHasSpoiler Boolean @default(false)

  isRewatch     Boolean @default(false) // revisionnage/relecture (F2)
  context       String? // contexte de consommation (F3, D10)
  isSeasonBatch Boolean @default(false) // entrée synthétique d'un marquage de saison (T4)

  watches EpisodeWatch[] // épisodes liés à une entrée synthétique
  tags    JournalEntryTag[] // étiquettes libres (lot 3, S10)

  /// Clé d'import (lot 2, I6) — colonne **inerte** depuis le retrait de
  /// l'import : plus personne ne l'écrit, mais elle marque les entrées venues
  /// d'un service tiers, que le fil continue d'écarter (`feed-query.ts`). La
  /// supprimer relâcherait d'un coup des milliers d'entrées dans le fil.
  importKey String?

  /// Masquée par la modération (lot 4, D25) — l'entrée reste à son auteur, qui
  /// continue de la voir coiffée d'un bandeau, mais elle sort des surfaces
  /// sociales. `null` = visible.
  hiddenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // social (lot 4)
  likes          SocialLike[]
  socialComments Comment[]
  notifications  Notification[]
  reports        Report[]

  @@unique([userId, importKey])
  @@index([userId, loggedAt])
  @@index([workId])
  /// Le fil antichronologique (P2) s'ordonne sur `createdAt`, jamais sur
  /// `loggedAt` : une entrée antidatée à 2011 n'est pas une actualité de 2011.
  @@index([userId, createdAt])
}

/// Progression à l'épisode (T1) — la présence = épisode vu.
model EpisodeWatch {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  watchedAt DateTime? // défaut aujourd'hui ; modifiable ; ou « sans date »

  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([userId, episodeId])
  @@index([userId])
}

/// Suivi au tome (L4).
model TomeProgress {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tomeId String
  tome   Tome      @relation(fields: [tomeId], references: [id], onDelete: Cascade)
  state  TomeState

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, tomeId])
  @@index([userId])
}

/// Historique de progression de lecture (L2) — alimente le rythme de lecture.
model ReadingProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  editionId String?
  edition   Edition? @relation(fields: [editionId], references: [id], onDelete: SetNull)

  page    Int?
  percent Int?

  recordedAt DateTime @default(now())

  @@index([userId, workId, recordedAt])
}

// ─────────────────────────────────────────────────────────────
// Bibliothèque riche (lot 3) — ranger, annoter, se fixer un cap.
//
// Tout ce qui suit est **personnel** : le catalogue reste partagé (D29), mais
// une liste, une étiquette, un favori ou un objectif n'appartiennent qu'à
// leur auteur, au même titre que le journal et les statuts du lot 1.
// ─────────────────────────────────────────────────────────────

/// Une liste personnelle, mono ou multi-médias (S9, D11).
model List {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  slug        String // slugify(title) — l'URL de la liste
  description String?
  isRanked    Boolean @default(false) // ordonnée (classement) ou simple recueil
  isPinned    Boolean @default(false) // épinglée sur l'accueil et le profil

  coverImageId String?
  coverImage   Image?  @relation("ListCover", fields: [coverImageId], references: [id], onDelete: SetNull)

  /// Clé de rejeu d'une liste importée (lot 2) ; null si saisie à la main.
  /// Inerte comme `JournalEntry.importKey`, et conservée pour la même raison :
  /// elle dit d'où vient la liste. PostgreSQL traite les NULL comme distincts
  /// dans un index unique, les listes manuelles cohabitent donc sans conflit.
  importKey String?

  /// Retirée des surfaces sociales par **son auteur** (lot 4, P5). À ne pas
  /// confondre avec `hiddenAt`, qui est une décision de modération : les deux
  /// coexistent parce qu'un auteur doit pouvoir reprendre sa liste, mais pas
  /// démasquer ce que la modération a masqué.
  isPrivate Boolean   @default(false)
  hiddenAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ListItem[]

  // social (lot 4)
  likes          SocialLike[]
  socialComments Comment[]
  notifications  Notification[]
  reports        Report[]

  @@unique([userId, slug])
  @@unique([userId, importKey])
  @@index([userId, isPinned])
  @@index([userId, createdAt])
}

/// Un élément de liste : sa place et le mot qui l'accompagne (S9).
model ListItem {
  id     String @id @default(cuid())
  listId String
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)
  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  position Int
  note     String? // commentaire par élément

  createdAt DateTime @default(now())

  /// Une œuvre n'apparaît qu'une fois par liste — le point d'idempotence du
  /// rejeu des listes importées.
  @@unique([listId, workId])
  @@index([listId, position])
}

/// Une étiquette libre, personnelle (S10). Le userId ne vit qu'ici : les
/// tables de jointure n'ont pas à le répéter.
model Tag {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String // libellé saisi, casse et accents conservés
  slug String // slugify(name) — l'identité réelle du tag

  createdAt DateTime @default(now())

  works   WorkTag[]
  entries JournalEntryTag[]

  @@unique([userId, slug])
}

/// Étiquette posée sur une œuvre (S10).
model WorkTag {
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([tagId, workId])
  @@index([workId])
}

/// Étiquette posée sur une entrée de journal (S10) — l'usage Letterboxd.
model JournalEntryTag {
  tagId   String
  tag     Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)
  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([tagId, entryId])
  @@index([entryId])
}

/// Les quelques œuvres mises en avant sur le profil (S11) — quatre au plus,
/// tous médias confondus. Le plafond et la compacité des positions sont tenus
/// par l'action, qui réécrit les lignes en bloc : pas de contrainte d'unicité
/// sur la position, qui rendrait toute permutation impossible sans valeur
/// temporaire.
model Favorite {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  position Int

  createdAt DateTime @default(now())

  @@unique([userId, workId])
  @@index([userId, position])
}

/// Portée d'un objectif annuel (L5, D12).
///
/// Un énuméré non nul plutôt qu'un `WorkType?` : « toutes confondues » serait
/// un NULL, que PostgreSQL laisse cohabiter en double dans un index unique —
/// l'objectif global n'aurait aucun garde-fou en base. READINGS répond en prime
/// à l'objectif que l'on se fixe vraiment (« 50 lectures »), plutôt que trois
/// objectifs séparés.
enum GoalScope {
  ALL
  READINGS // livres + BD + mangas — activé par défaut (D12)
  FILM
  SERIES
  ANIME
  BOOK
  BD_SERIES
  MANGA_SERIES
}

/// Objectif annuel paramétrable par média (L5, D12).
model Goal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  year   Int
  scope  GoalScope
  target Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year, scope])
  @@index([userId, year])
}

// ─────────────────────────────────────────────────────────────
// Social (lot 4) — la première ouverture de la lecture (§5.7, P1→P5)
//
// Les lots 1 à 3 tiennent une règle simple : toute lecture se referme sur
// `userId`. Le lot 4 l'inverse pour la première fois — d'où le soin porté
// ici aux règles onDelete et aux invariants.
//
// **Toute clé étrangère vers `User` est explicitement `Cascade`, ou nullable
// et `SetNull`.** `Work.createdById` est en Restrict (le défaut), ce qui a
// imposé la réattribution des fiches à un compte système dans
// `deleteMyAccount` ; une seule FK oubliée ici ferait échouer
// `db.user.delete()` et casserait la suppression de compte (N9). La section
// `verifySocial` de `scripts/verify.ts` le prouve contre la vraie base.
//
// Trois invariants ne peuvent pas être tenus par PostgreSQL et vivent dans
// les actions, comme « une seule édition par défaut » au lot 3 : une seule
// colonne de cible renseignée, `followerId != followingId`, et un signalement
// ouvert par rapporteur et par cible.
// ─────────────────────────────────────────────────────────────

/// Visibilité d'un compte (D26, P5).
///
/// Trois niveaux et non deux : les profils étant partageables par lien
/// (jalon B), il faut distinguer « ouvert au web » de « ouvert à l'instance ».
/// D26 dit « public par défaut, au sens visible des membres tant que le cercle
/// reste fermé » : MEMBERS est ce sens-là, PUBLIC est le partage par lien,
/// PRIVATE est l'option de compte privé.
enum ProfileVisibility {
  PUBLIC // visible de tous, y compris hors connexion
  MEMBERS // visible des membres connectés de l'instance
  PRIVATE // visible des seuls abonnés approuvés
}

enum FollowStatus {
  PENDING // demande en attente d'approbation (compte privé)
  ACCEPTED
}

enum NotificationType {
  FOLLOW
  FOLLOW_REQUEST
  FOLLOW_ACCEPTED
  LIKE
  COMMENT
  CORRECTION // proposition de correction sur une fiche (D30)
  MODERATION // contenu masqué ou supprimé (D25)
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  SEXUAL
  VIOLENCE
  SPOILER // critique non repliée qui divulgâche
  OTHER
}

enum ReportStatus {
  OPEN
  ACCEPTED // signalement retenu : contenu masqué ou supprimé
  REJECTED
}

/// Nature de la cible d'un signalement, **figée à la création**.
///
/// Contrairement à SocialLike et Comment, Report porte une colonne de type :
/// ses clés étrangères sont en SetNull pour qu'une suppression de contenu par
/// la modération n'efface pas la trace du signalement. Une fois la FK à NULL,
/// cette colonne et le libellé figé sont tout ce qui rend la file lisible.
enum ReportTargetKind {
  USER
  JOURNAL_ENTRY
  LIST
  REVIEW
  COMMENT
  WORK
}

enum CorrectionStatus {
  OPEN
  APPLIED
  REJECTED
}

/// Abonnement (P2). Un compte privé (D26) place la demande en PENDING ; tout
/// autre la crée directement ACCEPTED.
///
/// `followerId != followingId` n'est pas déclarable en Prisma (pas de CHECK) :
/// l'invariant vit dans `followUser`.
model Follow {
  id          String       @id @default(cuid())
  followerId  String
  follower    User         @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User         @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  status      FollowStatus @default(ACCEPTED)
  createdAt   DateTime     @default(now())
  acceptedAt  DateTime?

  @@unique([followerId, followingId])
  @@index([followingId, status]) // mes abonnés, mes demandes en attente
  @@index([followerId, status]) // mes abonnements — la source du fil
}

/// Blocage (D25, P4). Stocké dans **un** sens, appliqué dans **les deux** : si
/// A bloque B, ni l'un ni l'autre ne se voit ni n'interagit.
///
/// Cette asymétrie entre stockage et effet est la première source d'erreur du
/// lot. Elle est neutralisée par un helper unique, `blockedUserIds()`
/// (`src/lib/social/read.ts`), que traversent toutes les lectures — aucune
/// requête ne consulte cette table directement.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// J'aime social (P3) sur une entrée de journal, une liste ou une critique
/// d'œuvre.
///
/// **Trois clés étrangères réelles plutôt qu'un couple (type, id)** : c'est la
/// cascade qui tranche. `deleteJournalEntry` existe depuis le lot 1 ; sans FK,
/// elle laisserait derrière elle des j'aime et des commentaires orphelins que
/// rien ne nettoierait.
///
/// **Une seule table plutôt que trois** : compteurs, file de modération,
/// notifications et export parlent de « j'aime » sans distinction. Trois tables
/// imposeraient trois requêtes et trois branches partout — avec les
/// commentaires et les signalements, on passerait de 4 tables à 12.
///
/// Nommé SocialLike et non Like : `UserWork.liked` est le j'aime **personnel
/// sur l'œuvre** (S6), une donnée de suivi. Les deux ne doivent jamais être
/// confondus, ni dans le code, ni dans les compteurs, ni dans l'interface.
/// (« Like » est en prime un mot réservé SQL.)
model SocialLike {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  listId         String?
  list           List?         @relation(fields: [listId], references: [id], onDelete: Cascade)
  userWorkId     String?
  userWork       UserWork?     @relation(fields: [userWorkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// Trois uniques plutôt qu'un seul sur (userId, type, id) : PostgreSQL
  /// traitant les NULL comme distincts, chaque contrainte ne mord que sur les
  /// lignes dont la colonne concernée est renseignée. C'est le mécanisme qui
  /// fait déjà cohabiter les `importKey` manuelles du lot 2.
  ///
  /// L'invariant « exactement une des trois colonnes est non nulle » n'est pas
  /// déclarable : il vit dans `src/lib/social-target.ts`, testé, et traverse
  /// toutes les actions.
  @@unique([userId, journalEntryId])
  @@unique([userId, listId])
  @@unique([userId, userWorkId])
  @@index([journalEntryId])
  @@index([listId])
  @@index([userWorkId])
}

/// Commentaire (P3). Fil **plat** en v1 : pas de `parentId`, décision assumée
/// du cahier des charges. L'ajouter plus tard serait une migration additive.
///
/// Le corps est rendu par `<Markdown>` (`src/lib/markdown.tsx`), écrit dès le
/// lot 1 en vue de ce moment : aucun HTML brut, protocoles restreints, liens
/// en nofollow.
model Comment {
  id       String @id @default(cuid())
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  listId         String?
  list           List?         @relation(fields: [listId], references: [id], onDelete: Cascade)
  userWorkId     String?
  userWork       UserWork?     @relation(fields: [userWorkId], references: [id], onDelete: Cascade)

  body     String
  hiddenAt DateTime? // masqué par la modération (D25)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]
  reports       Report[]

  @@index([journalEntryId, createdAt])
  @@index([listId, createdAt])
  @@index([userWorkId, createdAt])
  @@index([authorId])
}

/// Notification interne (P3) — jamais d'e-mail, le cahier des charges dit
/// « notifications internes ».
///
/// Créée **dans la transaction de l'action** qui la motive : une écriture qui
/// échoue ne doit pas laisser de notification fantôme.
///
/// Pas de contrainte d'unicité : un `@@unique` couvrant (destinataire, acteur,
/// type, cible) serait inopérant à cause des NULL et interdirait deux
/// commentaires successifs du même auteur. Le regroupement (« ne pas empiler
/// une notification identique **non lue** ») est une règle métier, portée par
/// `src/lib/notify-rules.ts`.
model Notification {
  id     String @id @default(cuid())
  userId String // destinataire
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  /// Auteur du geste. Nullable pour les notifications système (modération).
  /// Cascade : un compte supprimé retire ses gestes des boîtes des autres.
  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  type NotificationType

  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  listId         String?
  list           List?         @relation(fields: [listId], references: [id], onDelete: Cascade)
  userWorkId     String?
  userWork       UserWork?     @relation(fields: [userWorkId], references: [id], onDelete: Cascade)
  commentId      String?
  comment        Comment?      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  workId         String?
  work           Work?         @relation(fields: [workId], references: [id], onDelete: Cascade)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt]) // le compteur de non-lues, appelé sur chaque page
}

/// Signalement de contenu ou de compte (D25, P4).
///
/// Les FK de cible sont en **SetNull** et non en Cascade : si l'administrateur
/// supprime le contenu incriminé, le signalement doit rester dans l'historique.
/// D'où le triptyque figé `targetKind` / `targetLabel` / `targetExcerpt`, seule
/// chose qui rende la file lisible une fois les FK à NULL.
///
/// L'unicité « un signalement ouvert par rapporteur et par cible » n'est pas
/// déclarable ici : `reporterId` étant nullable, deux rapporteurs supprimés
/// produiraient deux NULL considérés distincts. La règle vit dans
/// `reportContent()`.
model Report {
  id String @id @default(cuid())

  reporterId String?
  reporter   User?   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  targetKind ReportTargetKind

  /// Instantané pris au moment du signalement : titre de liste, titre d'œuvre,
  /// nom d'utilisateur. Le contenu peut disparaître, la file doit rester lisible.
  targetLabel String

  /// Extrait du texte incriminé (200 caractères, markdown retiré).
  targetExcerpt String?

  reportedUserId String?
  reportedUser   User?         @relation("ReportReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  listId         String?
  list           List?         @relation(fields: [listId], references: [id], onDelete: SetNull)
  userWorkId     String?
  userWork       UserWork?     @relation(fields: [userWorkId], references: [id], onDelete: SetNull)
  commentId      String?
  comment        Comment?      @relation(fields: [commentId], references: [id], onDelete: SetNull)
  workId         String?
  work           Work?         @relation(fields: [workId], references: [id], onDelete: SetNull)

  reason  ReportReason
  details String?
  status  ReportStatus @default(OPEN)

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolution   String? // note de l'administrateur

  createdAt DateTime @default(now())

  @@index([status, createdAt]) // la file de modération
  @@index([reportedUserId])
}

/// Proposition de correction sur une fiche (D30) — le contrepoids au droit
/// d'édition réservé au créateur et à l'administrateur (R8). Notifie les deux.
model CorrectionSuggestion {
  id       String @id @default(cuid())
  workId   String
  work     Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation("CorrectionAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  /// Champ visé, à titre indicatif (« année », « titre original », « visuel »).
  field   String?
  message String

  status      CorrectionStatus @default(OPEN)
  handledAt   DateTime?
  handledById String?
  handledBy   User?            @relation("CorrectionHandler", fields: [handledById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([workId, status])
  @@index([status, createdAt])
}
